### .env example for production please change values


# Application
APP_ENV=development
APP_VERSION=1.0.0
PORT=8080
LOG_LEVEL=info
LOG_FORMAT=json
METRICS_ENABLED=true
TRACING_ENABLED=true

# HTTP server
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=20s
SERVER_MAX_BODY_BYTES=1048576
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
ADMIN_API_KEY=
INBOUND_WEBHOOK_SECRET=

# Authentication
JWT_SECRET=development-only-secret-change-me
JWT_ISSUER=blockchain-payment-gateway
JWT_AUDIENCE=merchant-api
JWT_TTL=24h
API_KEY_ENV=test

# Persistence: memory (default) or postgres
DATABASE_DRIVER=memory
DATABASE_URL=postgres://gateway:gateway@localhost:5432/gateway?sslmode=disable
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME=30m
DATABASE_AUTO_MIGRATE=true

# Cache: memory (default) or redis
CACHE_DRIVER=memory
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_DEFAULT_TTL=5m

# Blockchain adapters. Set BLOCKCHAIN_MOCK=true for local development.
BLOCKCHAIN_MOCK=false
BLOCKCHAIN_WATCH_INTERVAL=15s
BLOCKCHAIN_CONFIRMATION_INTERVAL=10s
BLOCKCHAIN_HTTP_TIMEOUT=15s

ETHEREUM_ENABLED=true
ETHEREUM_RPC_URL=http://localhost:8545
ETHEREUM_WS_URL=
ETHEREUM_NETWORK=sepolia
ETHEREUM_DEPOSIT_ADDRESS=
ETHEREUM_CONFIRMATIONS=12
ETHEREUM_LOOKBACK_BLOCKS=12
ETHEREUM_FEE_MULTIPLIER=1.1

BITCOIN_ENABLED=true
BITCOIN_RPC_URL=http://localhost:8332
BITCOIN_RPC_USER=bitcoin
BITCOIN_RPC_PASSWORD=bitcoin
BITCOIN_NETWORK=testnet
BITCOIN_DEPOSIT_ADDRESS=
BITCOIN_CONFIRMATIONS=3
BITCOIN_FEE_MULTIPLIER=1.1

SOLANA_ENABLED=true
SOLANA_RPC_URL=http://localhost:8899
SOLANA_NETWORK=devnet
SOLANA_DEPOSIT_ADDRESS=
SOLANA_CONFIRMATIONS=1
SOLANA_FEE_MULTIPLIER=1.0

CARDANO_ENABLED=false
CARDANO_RPC_URL=https://cardano-preprod.blockfrost.io/api/v0
CARDANO_API_KEY=
CARDANO_NETWORK=testnet
CARDANO_DEPOSIT_ADDRESS=
CARDANO_CONFIRMATIONS=15
CARDANO_FEE_MULTIPLIER=1.0

# Exchange rates
EXCHANGE_PROVIDER=binance
BINANCE_API_URL=https://api.binance.com
CRYPTOCOMPARE_API_URL=https://min-api.cryptocompare.com
EXCHANGE_CACHE_TTL=60s
EXCHANGE_HTTP_TIMEOUT=10s

# Notifications
EMAIL_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.com

SMS_ENABLED=false
SMS_ENDPOINT=
SMS_TOKEN=
SMS_FROM=

WEBHOOK_TIMEOUT=10s
WEBHOOK_MAX_RETRIES=5
WEBHOOK_SIGNATURE_HEADER=X-Signature
WEBHOOK_USER_AGENT=blockchain-payment-gateway/1.0

# Queue
QUEUE_DRIVER=memory
QUEUE_WORKERS=4
QUEUE_BUFFER=1024

# Fraud engine
FRAUD_MAX_AMOUNT_USD=100000
FRAUD_VELOCITY_WINDOW=1h
FRAUD_MAX_PAYMENTS_PER_WINDOW=30
FRAUD_RISK_THRESHOLD=70
FRAUD_BLACKLISTED_ADDRESSES=
FRAUD_BLOCKED_COUNTRIES=

# Escrow
ESCROW_DEFAULT_RELEASE_DELAY=0s
ESCROW_MAX_DURATION=720h
ESCROW_ALLOW_FORCE_RELEASE=false

# Optional gRPC listener (reserved)
GRPC_ENABLED=false
GRPC_PORT=9090
